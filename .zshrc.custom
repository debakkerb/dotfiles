alias git-clean="git checkout main && git pull && git fetch -p && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '\$2 == \"[gone]\" {print \$1}' | xargs -r git branch -D"

alias tf=terraform
alias tfir='terraform init -reconfigure'

alias vi=nvim
alias vim=nvim

alias gconfigs="gcloud config configurations list"
alias gconfig='function _gconfig(){ gcloud config configurations activate "$1"; }; _gconfig'

export PATH=$HOME/tools/bin:$PATH
export PATH=$HOME/go/bin:$PATH
export PATH="$(brew --prefix python)/libexec/bin:$PATH"
export PATH=$PATH:$HOME/.local/bin
export PATH="$HOME/.local/bin:$PATH"

# The next line updates PATH for the Google Cloud SDK.
if [ -f "$HOME/tools/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/tools/google-cloud-sdk/path.zsh.inc"; fi

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/tools/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/tools/google-cloud-sdk/completion.zsh.inc"; fi

HOMEBREW_NO_AUTO_UPDATE=1
